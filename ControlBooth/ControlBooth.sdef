<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="ControlBooth Terminology">
    <suite name="ControlBooth Suite" code="CBth"
           description="Control ControlBooth's process pipelines.">

        <command name="start pipeline" code="CBthStrt"
                 description="Start the pipeline with the given name.">
            <cocoa class="StartPipelineCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
            <direct-parameter type="text" description="The name of the pipeline to start."/>
        </command>

        <command name="stop pipeline" code="CBthStop"
                 description="Stop the running pipeline with the given name.">
            <cocoa class="StopPipelineCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
            <direct-parameter type="text" description="The name of the pipeline to stop."/>
        </command>

        <command name="stop all pipelines" code="CBthStpA"
                 description="Stop every running pipeline.">
            <cocoa class="StopAllPipelinesCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
        </command>

        <command name="list pipelines" code="CBthList"
                 description="The names of all saved pipelines.">
            <cocoa class="ListPipelinesCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
            <result description="The pipeline names.">
                <type type="text" list="yes"/>
            </result>
        </command>

        <command name="running pipelines" code="CBthRuns"
                 description="The names of the pipelines that are currently running.">
            <cocoa class="RunningPipelinesCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
            <result description="The running pipeline names.">
                <type type="text" list="yes"/>
            </result>
        </command>

        <command name="airplay status" code="CBthApSt"
                 description="Whether the AirPlay receiver is on, relaying to AntennaHead, and actively receiving audio.">
            <cocoa class="AirPlayStatusCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
            <result description="[enabled, relayEnabled, isReceivingAudio], in that order.">
                <type type="boolean" list="yes"/>
            </result>
        </command>

        <command name="start airplay relay" code="CBthApOn"
                 description="Turn the AirPlay receiver on if needed and start relaying its audio to AntennaHead.">
            <cocoa class="StartAirPlayRelayCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
        </command>

        <command name="stop airplay relay" code="CBthApOf"
                 description="Stop relaying the AirPlay receiver's audio to AntennaHead, without turning the receiver off.">
            <cocoa class="StopAirPlayRelayCommand"/>
            <access-group identifier="com.dsward.ControlBooth.pipelines"/>
        </command>

    </suite>
</dictionary>
